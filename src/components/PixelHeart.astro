---
interface Props {
  large?: boolean;
}
const { large = false } = Astro.props;
const rows = [
  '01110001110',
  '11111011111',
  '11111111111',
  '11111111111',
  '01111111110',
  '00111111000',
  '00011111000',
  '00001110000',
  '00000100000',
];
---

<svg
  class:list={['pixel-heart', { large }]}
  viewBox="0 0 11 9"
  aria-hidden="true"
  shape-rendering="crispEdges"
  xmlns="http://www.w3.org/2000/svg"
>
  {
    rows.flatMap((row, y) =>
      [...row].map(
        (pixel, x) =>
          pixel === '1' && (
            <rect x={x} y={y} width="1" height="1" fill="currentColor" />
          ),
      ),
    )
  }
  {
    large && (
      <>
        <>
          <path d="M2 1h1v1H2zM1 2h1v1H1z" fill="var(--screen-light)" />
          <path
            d="M3 6h5v1H3zM4 7h3v1H4zM5 8h1v1H5z"
            fill="var(--screen-mid)"
          />
        </>
      </>
    )
  }
</svg>
