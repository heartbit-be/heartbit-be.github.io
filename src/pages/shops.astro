---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { shops } from '../data/site';
---

<Layout
  title="Shops & links"
  description="Find Heartbit’s future webshop and Etsy store, with more places to follow the work as they open."
>
  <PageHeading
    eyebrow="04 / THE MARKETPLACE"
    title="A few places to find Heartbit."
    description="The shops are still taking shape. This is where their doors will open."
  />
  <section class="content-section" aria-label="Shops">
    {
      shops.map((shop) => (
        <article class="shop-detail">
          <div>
            <>
              <h2>{shop.name}</h2>
              <p>{shop.description}</p>
            </>
          </div>
          {shop.url ? (
            <a class="text-link" href={shop.url}>
              Visit the shop ↗
            </a>
          ) : (
            <span class="coming-soon">Coming soon</span>
          )}
        </article>
      ))
    }
  </section>
  <section class="contact-strip">
    <div>
      <p class="eyebrow">HAVE A PRINT IN MIND?</p><h2>
        You can already say hello.
      </h2>
    </div><a class="pixel-button" href="/contact/?interest=3d-printing"
      >Discuss a print <span aria-hidden="true">→</span></a
    >
  </section>
</Layout>
