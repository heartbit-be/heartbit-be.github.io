---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Arrow from '../components/Arrow.astro';
import { translations, type Locale } from '../i18n';
import { modelUrl } from '../data/site';
interface Props {
  lang: Locale;
  automatic?: boolean;
}
const { lang, automatic = false } = Astro.props;
const all = translations[lang];
const t = all.printing;
---

<Layout
  lang={lang}
  page="3d-printing"
  automatic={automatic}
  title={t.title}
  description={t.metaDescription}
>
  <PageHeading
    lang={lang}
    eyebrow={t.eyebrow}
    title={t.heading}
    description={t.intro}
  />
  <div class="page-actions">
    <ContactLinks lang={lang} emailLabel={t.action} subject={t.subject} />
  </div>
  <section class="printing-example" aria-labelledby="holder-title">
    <p class="eyebrow">{t.exampleEyebrow}</p>
    <h2 id="holder-title">{t.exampleTitle}</h2>
    <div class="prose">
      <p>
        {t.example[0]}
      </p>
      <p>
        {t.example[1]}
      </p>
      <p>
        {t.example[2]}
      </p>
      <a class="text-link" href={modelUrl}>{t.model} <Arrow /></a>
    </div>
  </section>
  <section class="contact-strip" aria-labelledby="printing-contact-title">
    <div>
      <h2 id="printing-contact-title">{t.contactTitle}</h2>
      <p>
        {t.contact}
      </p>
    </div>
    <ContactLinks lang={lang} subject={t.subject} />
  </section>
</Layout>
