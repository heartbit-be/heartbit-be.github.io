---
import Layout from '../layouts/Layout.astro';
import PixelHeart from '../components/PixelHeart.astro';
import Arrow from '../components/Arrow.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { translations, pageUrl, type Locale } from '../i18n';
interface Props {
  lang: Locale;
  automatic?: boolean;
}
const { lang, automatic = false } = Astro.props;
const all = translations[lang];
const t = all.home;
---

<Layout
  lang={lang}
  page=""
  automatic={automatic}
  title={t.title}
  description={t.description}
>
  <section class="pocket-screen" aria-labelledby="hero-title">
    <div class="screen-bar">
      <span>{t.screen}</span>
      <span class="lives" aria-hidden="true">
        <PixelHeart /><PixelHeart /><PixelHeart />
      </span>
    </div>
    <div class="hero">
      <div>
        <h1 id="hero-title">
          {t.greeting}<span class="hero-role">
            {t.role}
          </span>
        </h1>
        <p class="hero-copy">
          {t.intro}
        </p>
        <div class="actions">
          <a class="pixel-button" href={pageUrl(lang, 'experience')}
            >{t.explore} <Arrow direction="right" /></a
          >
          <a class="text-link" href="#contact">{all.common.contact} <Arrow /></a
          >
        </div>
      </div>
      <div class="heart-display">
        <button
          class="heart-button"
          type="button"
          aria-label={t.heartLabel}
          data-clicked={t.heartClicked}
          data-status={t.heartStatus}><PixelHeart large /></button
        >
        <span class="heart-shadow" aria-hidden="true"></span>
        <p class="eyebrow" data-heart-caption>
          {t.heartCaption}
        </p>
        <span class="sr-only" role="status" data-heart-status></span>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="capabilities-title">
    <div class="section-heading">
      <h2 id="capabilities-title">{t.capabilitiesTitle}</h2>
    </div>
    <div class="capabilities">
      {
        t.capabilities.map((capability, index) => (
          <article class="capability">
            <p class="eyebrow">0{index + 1}</p>
            <h3>{capability.name}</h3>
            <p>{capability.description}</p>
          </article>
        ))
      }
    </div>
  </section>
  <section class="intro section" aria-labelledby="team-title">
    <h2 id="team-title">{t.teamTitle}</h2>
    <p>
      {t.team}
    </p>
  </section>
  <section class="contact-panel" id="contact" aria-labelledby="contact-title">
    <div>
      <h2 id="contact-title">{all.common.contact}</h2>
      <p>
        {t.contact}
      </p>
      <p class="location">
        {t.location}
      </p>
    </div>
    <ContactLinks lang={lang} />
  </section>
  <section class="intro section beyond-software" aria-labelledby="beyond-title">
    <h2 id="beyond-title">{t.beyondTitle}</h2>
    <div>
      <p>
        {t.beyond}
      </p>
      <a class="text-link" href={pageUrl(lang, '3d-printing')}
        >{t.printingLink} <Arrow /></a
      >
    </div>
  </section>
</Layout>
<script>
  const button = document.querySelector<HTMLButtonElement>('.heart-button');
  const caption = document.querySelector<HTMLElement>('[data-heart-caption]');
  const status = document.querySelector<HTMLElement>('[data-heart-status]');
  button?.addEventListener('click', () => {
    if (!button || !caption || !status) return;
    button.classList.remove('beating');
    requestAnimationFrame(() =>
      requestAnimationFrame(() => button.classList.add('beating')),
    );
    caption.textContent = button.dataset.clicked || '';
    status.textContent = button.dataset.status || '';
  });
</script>
