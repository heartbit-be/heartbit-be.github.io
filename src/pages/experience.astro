---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { cvUrl, experience } from '../data/site';
---

<Layout
  title="Experience"
  description="A closer look at my work in software engineering, technical leadership, and architecture, including the renewal of a production application."
>
  <PageHeading
    eyebrow="01 / SOFTWARE & TEAMS"
    title="Experience"
    description="A closer look at my work in software engineering, technical leadership, and architecture."
  />
  <section class="cv-panel" aria-labelledby="cv-title">
    <div>
      <h2 id="cv-title">My CV</h2>
      <p>My background, experience, and education in one PDF.</p>
    </div>
    <div class="actions">
      <a class="pixel-button" href={cvUrl}>View CV (PDF)</a>
      <a class="pixel-button" href={cvUrl} download>Download CV (PDF)</a>
    </div>
  </section>
  <section class="section" aria-labelledby="experience-title">
    <div class="section-heading">
      <h2 id="experience-title">Selected experience</h2>
    </div>
    <div class="experience-list">
      {
        experience.map((entry) => (
          <article class="experience-entry">
            <div>
              <p class="eyebrow">{entry.company}</p>
              <p class="eyebrow">{entry.dates}</p>
            </div>
            <div>
              <h3>{entry.role}</h3>
              <p>{entry.description}</p>
              <p>Technologies: {entry.technologies}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section" aria-labelledby="education-title">
    <div class="section-heading">
      <h2 id="education-title">Education</h2>
    </div>
    <div class="experience-list">
      <article class="experience-entry">
        <p class="eyebrow">September 2013–January 2016</p>
        <div>
          <h3>Master of Engineering: Computer Science</h3>
          <p>University of Leuven</p>
        </div>
      </article>
      <article class="experience-entry">
        <p class="eyebrow">September 2010–July 2013</p>
        <div>
          <h3>Bachelor of Informatics</h3>
          <p>Universiteit Hasselt</p>
        </div>
      </article>
    </div>
  </section>
  <section class="section" aria-labelledby="project-title">
    <div class="section-heading">
      <h2 id="project-title">Renewing an application</h2>
    </div>
    <details class="project-story">
      <summary>Read the project story</summary>
      <div class="prose">
        <p>
          An application that began as a proof of concept had become a
          production system. As its use grew, users ran into problems and its
          original technical choices stood in the way of requested features.
        </p>
        <p>
          I gathered user issues and feature requests, developed the functional
          and technical analysis, and designed the cloud architecture, domain
          model, and APIs. I made the case for renewal to leadership, then
          implemented and delivered the replacement myself.
        </p>
        <p>
          The replacement improved security and user experience, made previously
          blocked features possible, and opened the application to external
          clients. It was designed for extension and scale.
        </p>
      </div>
    </details>
  </section>
  <section class="contact-strip" aria-labelledby="experience-contact-title">
    <h2 id="experience-contact-title">Let's talk about your team.</h2>
    <ContactLinks />
  </section>
</Layout>
