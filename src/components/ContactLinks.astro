---
import { contactEmail, linkedInUrl } from '../data/site';
import Arrow from './Arrow.astro';
import { translations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  emailLabel?: string;
  subject?: string;
}
const { emailLabel = translations[Astro.props.lang].common.email, subject } =
  Astro.props;
const emailLink = `mailto:${contactEmail}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
---

<div class="actions">
  <a class="pixel-button" href={emailLink}>{emailLabel} <Arrow /></a>
  {
    linkedInUrl && (
      <a class="text-link" href={linkedInUrl}>
        LinkedIn <Arrow />
      </a>
    )
  }
</div>
