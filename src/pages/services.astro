---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { services } from '../data/site';
---

<Layout
  title="Services"
  description="Software architecture, software engineering, AI engineering, and 3D printing by Heartbit."
>
  <PageHeading
    eyebrow="03 / CHOOSE YOUR QUEST"
    title="From systems to objects."
    description="Help with the software you want to build and the things you want to make."
  />
  <section class="content-section service-list" aria-label="Services">
    {
      services.map((service, i) => (
        <article class="service-item" id={service.id}>
          <>
            <p class="eyebrow">0{i + 1}</p>
            <h2>{service.name}</h2>
            <p>{service.description}</p>
            <a class="text-link" href={`/contact/?interest=${service.id}`}>
              {service.action} ↗
            </a>
          </>
        </article>
      ))
    }
  </section>
</Layout>
