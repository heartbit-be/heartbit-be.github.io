---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { contactEmail, services } from '../data/site';
const emailLink = `mailto:${contactEmail}`;
---

<Layout
  title="Get in touch"
  description="Contact Laurens at Heartbit about software architecture, engineering, AI, or a 3D print."
>
  <PageHeading
    eyebrow="05 / GET IN TOUCH"
    title="Tell me what you have in mind."
    description="A software challenge, an AI idea, a 3D print, or simply a question. Start here."
  />
  <section class="content-section enquiry">
    <p>
      Write to <a href={emailLink}>{contactEmail}</a>, or put a few thoughts
      together below.
    </p>
    <label
      >What can I help with?<select id="interest" name="interest"
        >{
          services.map((service) => (
            <option value={service.id}>{service.name}</option>
          ))
        }<option value="other" selected>Something else / not sure yet</option
        ></select
      ></label
    >
    <label
      >A little about your project<textarea
        id="message"
        name="message"
        rows="5"
        placeholder="What would you like to build or make?"></textarea></label
    >
    <a
      class="pixel-button"
      id="email-draft"
      href={emailLink}
      data-email={contactEmail}
      >Open email draft <span aria-hidden="true">↗</span></a
    >
    <p class="contact-help">
      Opens your email app. You can review everything before sending. Nothing is
      submitted through this website.
    </p>
    <noscript
      ><p class="notice">
        Use the email address above to get in touch. Preparing a draft from
        these fields requires JavaScript.
      </p></noscript
    >
  </section>
</Layout>
<script>
  const interest = document.querySelector<HTMLSelectElement>('#interest');
  const message = document.querySelector<HTMLTextAreaElement>('#message');
  const draft = document.querySelector<HTMLAnchorElement>('#email-draft');
  if (interest && message && draft) {
    const requested = new URLSearchParams(window.location.search).get(
      'interest',
    );
    if (
      requested &&
      [...interest.options].some((option) => option.value === requested)
    )
      interest.value = requested;
    const updateDraft = () => {
      const label = interest.selectedOptions[0]?.textContent || 'A project';
      const subject = encodeURIComponent(`Heartbit enquiry: ${label}`);
      const body = encodeURIComponent(message.value);
      draft.href = `mailto:${draft.dataset.email}?subject=${subject}&body=${body}`;
    };
    interest.addEventListener('change', updateDraft);
    message.addEventListener('input', updateDraft);
    updateDraft();
  }
</script>
